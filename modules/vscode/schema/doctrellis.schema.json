{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://doctrellis.org/schema/doctrellis.schema.json",
  "title": "DocTrellis workspace configuration",
  "description": "Configures the local preview process launched by the DocTrellis VS Code extension.",
  "oneOf": [
    {
      "title": "Version 1 fixed URL",
      "type": "object",
      "additionalProperties": false,
      "required": ["version", "preview"],
      "properties": {
        "version": { "const": 1 },
        "preview": { "$ref": "#/$defs/fixedPreview" }
      }
    },
    {
      "title": "Version 2 IPC-announced URL",
      "type": "object",
      "additionalProperties": false,
      "required": ["version", "preview"],
      "properties": {
        "version": { "const": 2 },
        "preview": { "$ref": "#/$defs/announcedPreview" }
      }
    }
  ],
  "$defs": {
    "command": {
      "type": "string",
      "minLength": 1,
      "pattern": "^(?=.*\\S)[^\\u0000]*$",
      "description": "Native executable to spawn directly. This is not interpreted as a shell string; Windows .bat and .cmd launchers require a native executable shim."
    },
    "args": {
      "type": "array",
      "description": "Arguments passed directly and verbatim to the executable.",
      "items": {
        "type": "string",
        "pattern": "^[^\\u0000]*$"
      }
    },
    "workingDirectory": {
      "type": "string",
      "minLength": 1,
      "pattern": "^(?=.*\\S)[^\\u0000]*$",
      "description": "Directory relative to the workspace folder. It must remain inside that folder."
    },
    "startupTimeoutMs": {
      "type": "integer",
      "minimum": 1,
      "maximum": 600000,
      "description": "Maximum time to wait for the preview to become ready."
    },
    "fixedPreview": {
      "type": "object",
      "additionalProperties": false,
      "required": ["command", "args", "workingDirectory", "url", "startupTimeoutMs"],
      "properties": {
        "command": { "$ref": "#/$defs/command" },
        "args": { "$ref": "#/$defs/args" },
        "workingDirectory": { "$ref": "#/$defs/workingDirectory" },
        "url": {
          "type": "string",
          "format": "uri",
          "pattern": "^https?://(\\[[0-9A-Fa-f:.]+\\]|[A-Za-z0-9](?:[A-Za-z0-9.-]*[A-Za-z0-9])?)(?::(?!0{1,5}(?:[/?#]|$))(?:[0-9]{1,4}|0[0-9]{4}|[1-5][0-9]{4}|6[0-4][0-9]{3}|65[0-4][0-9]{2}|655[0-2][0-9]|6553[0-5]))?(?:[/?#][^\\s]*)?$",
          "description": "Fixed HTTP(S) URL polled until a 2xx or 3xx response is available."
        },
        "startupTimeoutMs": { "$ref": "#/$defs/startupTimeoutMs" }
      }
    },
    "announcedPreview": {
      "type": "object",
      "additionalProperties": false,
      "required": ["command", "args", "workingDirectory", "endpoint", "startupTimeoutMs"],
      "properties": {
        "command": { "$ref": "#/$defs/command" },
        "args": {
          "allOf": [{ "$ref": "#/$defs/args" }],
          "description": "Arguments passed verbatim. For sbt 2 use [\"--server\", \"--batch\", \"set doctrellisPort := 0\", \"doctrellisPreview\"]."
        },
        "workingDirectory": { "$ref": "#/$defs/workingDirectory" },
        "endpoint": {
          "type": "object",
          "additionalProperties": false,
          "required": ["source", "protocol"],
          "properties": {
            "source": { "const": "ipc" },
            "protocol": { "const": "doctrellis-preview-v1" }
          }
        },
        "startupTimeoutMs": { "$ref": "#/$defs/startupTimeoutMs" }
      }
    }
  }
}
